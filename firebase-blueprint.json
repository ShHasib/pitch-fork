{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and statistics",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Display name of the user"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address"
        },
        "dailyProfit": {
          "type": "number",
          "description": "Profit earned today"
        },
        "todayBonus": {
          "type": "number",
          "description": "Bonus earned today"
        },
        "assetBalance": {
          "type": "number",
          "description": "Current available balance"
        },
        "totalCommission": {
          "type": "number",
          "description": "Total commission earned"
        },
        "musicAssets": {
          "type": "number",
          "description": "Value of music assets"
        },
        "credit": {
          "type": "integer",
          "description": "User's credit score"
        },
        "level": {
          "type": "string",
          "description": "User's current level (e.g., LV1)"
        },
        "missionCount": {
          "type": "integer",
          "description": "Number of missions completed today"
        },
        "referralCode": {
          "type": "string",
          "description": "User's unique referral code"
        },
        "referredBy": {
          "type": "string",
          "description": "UID of the user who referred this user"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the account was created"
        }
      },
      "required": ["username", "email", "assetBalance", "level"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction record",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["deposit", "withdraw", "task", "commission"],
          "description": "Type of transaction"
        },
        "amount": {
          "type": "number",
          "description": "Transaction amount"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed", "failed"],
          "description": "Current status of the transaction"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the transaction occurred"
        },
        "description": {
          "type": "string",
          "description": "Optional details about the transaction"
        }
      },
      "required": ["type", "amount", "status", "timestamp"]
    },
    "Message": {
      "title": "Message",
      "description": "Internal message or notification",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Subject of the message"
        },
        "content": {
          "type": "string",
          "description": "Body of the message"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the message was sent"
        },
        "isRead": {
          "type": "boolean",
          "description": "Whether the user has read the message"
        },
        "type": {
          "type": "string",
          "enum": ["system", "support", "bonus"],
          "description": "Category of the message"
        }
      },
      "required": ["title", "content", "timestamp", "isRead"]
    },
    "GlobalConfig": {
      "title": "GlobalConfig",
      "description": "Global application settings",
      "type": "object",
      "properties": {
        "referralSystemEnabled": {
          "type": "boolean",
          "description": "Whether the referral system is active"
        },
        "referralCodeRequired": {
          "type": "boolean",
          "description": "Whether a referral code is required for registration"
        }
      }
    }
  },
  "firestore": {
    "/config/referral": {
      "schema": "GlobalConfig",
      "description": "Global settings for the referral system"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User documents keyed by their Firebase Auth UID"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User's transaction history"
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": "Message",
      "description": "User's internal messages and notifications"
    }
  }
}
